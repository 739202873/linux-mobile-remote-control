#!/usr/bin/env python3
"""Mobile-RC host helper CLI (`control-access`).

Usage:
  sudo control-access                 Generate a fresh 6-digit one-time code
  sudo control-access --setup-termux  Print 1-line setup command for Termux
  sudo control-access --setup-email   Configure Gmail/SMTP bot & allowed emails for online OTP
  sudo control-access --test-email    Send a test email using saved Email OTP settings
  control-access --status             Show service runtime and boot auto-start status
  sudo control-access --enable        Enable auto-start on boot
  sudo control-access --disable       Disable auto-start on boot
  sudo control-access --start         Start Mobile-RC service now
  sudo control-access --stop          Stop Mobile-RC service now
  sudo control-access --restart       Restart Mobile-RC service now
"""

import argparse
from email.message import EmailMessage
import getpass
import json
import os
import platform
import re
import shlex
import shutil
import smtplib
import ssl
import subprocess
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request

def _default_config_dir():
    env_dir = os.environ.get("MRC_CONFIG_DIR", "").strip()
    if env_dir:
        return env_dir
    if os.path.exists("/etc/NIXOS") or (
        os.path.isdir("/var/lib/mobile-rc") and not os.path.exists("/opt/mobile-rc/config.json")
    ):
        return "/var/lib/mobile-rc"
    return "/opt/mobile-rc"


def _find_bin(name):
    extra = (
        f"{os.environ.get('PATH', '')}:"
        "/run/wrappers/bin:/nix/var/nix/profiles/default/bin:/run/current-system/sw/bin:"
        "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    )
    return shutil.which(name, path=extra)


CONFIG_FILE = os.path.join(_default_config_dir(), "config.json")
DEFAULT_PORT = int(os.environ.get("MRC_PORT", "8000"))
_EMAIL_RE = re.compile(r"^[a-z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-z0-9-]+(?:\.[a-z0-9-]+)+$")

CYAN = "\033[0;36m"
GREEN = "\033[0;32m"
YELLOW = "\033[1;33m"
RED = "\033[0;31m"
BOLD = "\033[1m"
NC = "\033[0m"


def get_lan_ips():
    ips = []
    if shutil.which("ip"):
        res = subprocess.run(
            ["ip", "-4", "-o", "addr", "show", "scope", "global"],
            capture_output=True,
            text=True,
            check=False,
        )
        if res.returncode == 0:
            for line in res.stdout.splitlines():
                parts = line.split()
                if "inet" in parts:
                    idx = parts.index("inet") + 1
                    if idx < len(parts):
                        ip = parts[idx].split("/", 1)[0]
                        if ip and not ip.startswith("127.") and ip not in ips:
                            ips.append(ip)
    return ips


def get_mac_addresses():
    macs = []
    net_dir = "/sys/class/net"
    if os.path.isdir(net_dir):
        for iface in sorted(os.listdir(net_dir)):
            if iface == "lo":
                continue
            addr_path = os.path.join(net_dir, iface, "address")
            if os.path.exists(addr_path):
                try:
                    with open(addr_path, "r", encoding="utf-8") as f:
                        mac = f.read().strip().lower()
                    if mac and mac != "00:00:00:00:00:00":
                        macs.append({"iface": iface, "mac": mac})
                except OSError:
                    pass
    return macs


def load_config():
    if os.geteuid() != 0 and not os.access(CONFIG_FILE, os.R_OK):
        print(f"{RED}Permission denied reading {CONFIG_FILE}. Run with: sudo control-access{NC}", file=sys.stderr)
        sys.exit(1)
    if not os.path.exists(CONFIG_FILE):
        print(f"{RED}Config not found at {CONFIG_FILE}. Run sudo ./install.sh first.{NC}", file=sys.stderr)
        sys.exit(1)
    with open(CONFIG_FILE, "r", encoding="utf-8") as f:
        return json.load(f)


def print_termux_setup(cfg, port):
    ips = get_lan_ips()
    urls = [f"http://{ip}:{port}" for ip in ips]
    if not urls:
        urls.append(f"http://127.0.0.1:{port}")
    primary = urls[0]
    url_args = " ".join(shlex.quote(u) for u in urls)

    cmd = (
        f"rm -f \"$PREFIX/bin/kontrol-laptop\" && "
        f"mkdir -p \"$PREFIX/bin\" && "
        f"curl -fsSL {shlex.quote(primary + '/assets/control-access')} -o \"$PREFIX/bin/control-access\" && "
        f"chmod +x \"$PREFIX/bin/control-access\" && "
        f"control-access init {url_args}"
    )

    print(f"\n{CYAN}===================================================={NC}")
    print(f"{GREEN}{BOLD}   Termux Setup (`control-access` — Token-Free RAC) {NC}")
    print(f"{CYAN}===================================================={NC}")
    print("Paste this command into Termux on your smartphone (no secret token stored on phone):\n")
    print(f"{YELLOW}{cmd}{NC}\n")
    print("How it works when you type 'control-access' in Termux:")
    print(f"  - {CYAN}Local LAN{NC}  : Enter 6-digit RAC from 'sudo control-access' on PC -> auto-opens unlocked dashboard")
    print(f"  - {CYAN}Non-Local{NC}  : Enter registered Email -> receives 6-digit RAC via Email -> auto-opens unlocked dashboard")
    print(f"{CYAN}===================================================={NC}\n")


def request_code(cfg, port):
    token = str(cfg.get("termux_token") or "").strip()
    if not token:
        print(f"{RED}No termux_token found in {CONFIG_FILE}. Run sudo ./update.sh first.{NC}", file=sys.stderr)
        sys.exit(1)

    req = urllib.request.Request(
        f"http://127.0.0.1:{port}/api/pairing/code",
        data=b"{}",
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            data = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        print(f"{RED}Server returned HTTP {e.code}: {e.read().decode('utf-8', errors='ignore')}{NC}", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"{RED}Could not connect to Mobile-RC server on port {port}: {e}{NC}", file=sys.stderr)
        sys.exit(1)

    code = data.get("code", "")
    ttl = data.get("expires_in", 180)
    ips = data.get("ips") or get_lan_ips()
    tunnel_url = data.get("tunnel_url", "")

    print(f"\n{CYAN}============================================{NC}")
    print(f"{GREEN}{BOLD}   🔑 Mobile-RC • Random Access Code        {NC}")
    print(f"{CYAN}============================================{NC}")
    print(f"   Code    : {YELLOW}{BOLD}{code}{NC}")
    print(f"   Valid   : {ttl}s (single-use)")
    if ips:
        print(f"   URL     : {CYAN}http://{ips[0]}:{port}{NC}")
        for extra in ips[1:]:
            print(f"             {CYAN}http://{extra}:{port}{NC}")
    else:
        print(f"   URL     : {CYAN}http://localhost:{port}{NC}")
    if tunnel_url:
        print(f"   Tunnel  : {CYAN}{tunnel_url}{NC}")
    print(f"{CYAN}============================================{NC}\n")


def print_pair_info(cfg, port):
    token = str(cfg.get("termux_token") or "").strip()
    if not token:
        print(f"{RED}No termux_token found in {CONFIG_FILE}. Run sudo ./update.sh first.{NC}", file=sys.stderr)
        sys.exit(1)

    req = urllib.request.Request(
        f"http://127.0.0.1:{port}/api/pairing/code",
        data=b"{}",
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            data = json.loads(resp.read().decode("utf-8"))
    except Exception as e:
        print(f"{RED}Could not request live pairing info from port {port}: {e}{NC}", file=sys.stderr)
        sys.exit(1)

    code = data.get("code", "")
    ttl = data.get("expires_in", 180)
    ips = data.get("ips") or get_lan_ips()
    macs = get_mac_addresses()
    primary_host = ips[0] if ips else "127.0.0.1"
    primary_mac = macs[0]["mac"] if macs else ""
    pair_uri = urllib.parse.urlencode({
        "host": primary_host,
        "port": str(port),
        "code": code,
        "mac": primary_mac,
    })

    print(f"\n{CYAN}===================================================={NC}")
    print(f"{GREEN}{BOLD}   Mobile-RC • App & Device Pairing Info{NC}")
    print(f"{CYAN}===================================================={NC}")
    print(f"   One-Time Code : {YELLOW}{BOLD}{code}{NC} (valid {ttl}s)")
    print(f"   Primary URL   : {CYAN}http://{primary_host}:{port}{NC}")
    for extra in ips[1:]:
        print(f"   Alt LAN URL   : {CYAN}http://{extra}:{port}{NC}")
    for m in macs:
        print(f"   NIC MAC (WoL) : {CYAN}{m['iface']} -> {m['mac']}{NC}")
    print(f"   Pair URI      : {YELLOW}mobilerc://pair?{pair_uri}{NC}")
    print(f"{CYAN}===================================================={NC}\n")


def _norm_email(val):
    s = str(val or "").strip().lower()
    if not s or len(s) > 254 or any(ch in s for ch in ("\r", "\n", "\0", "<", ">", " ")):
        return ""
    return s if _EMAIL_RE.match(s) else ""


def save_config(cfg):
    cfg_dir = os.path.dirname(CONFIG_FILE) or "/opt/mobile-rc"
    os.makedirs(cfg_dir, mode=0o700, exist_ok=True)
    fd, tmp_path = tempfile.mkstemp(prefix=".cfg_", dir=cfg_dir)
    try:
        os.chmod(tmp_path, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(cfg, f, indent=2)
        os.chmod(tmp_path, 0o600)
        os.replace(tmp_path, CONFIG_FILE)
    finally:
        if os.path.exists(tmp_path):
            try:
                os.unlink(tmp_path)
            except OSError:
                pass


def send_test_email(cfg, recipient=None):
    sec = cfg.get("email_otp") or {}
    host = str(sec.get("smtp_host") or "smtp.gmail.com").strip()
    port = int(sec.get("smtp_port") or 587)
    user = _norm_email(sec.get("smtp_user") or "")
    pwd = str(sec.get("smtp_pass") or "").strip()
    if host.lower().endswith("gmail.com"):
        pwd = pwd.replace(" ", "")
    allowed = [_norm_email(x) for x in (sec.get("allowed_emails") or []) if _norm_email(x)]
    target = _norm_email(recipient) if recipient else (allowed[0] if allowed else "")

    if not (host and user and pwd and target):
        print(f"{RED}Email OTP is not fully configured yet. Run: sudo control-access --setup-email{NC}", file=sys.stderr)
        sys.exit(1)

    msg = EmailMessage()
    msg["Subject"] = "[Mobile-RC] SMTP Bot Test"
    msg["From"] = user
    msg["To"] = target
    msg.set_content(
        f"Mobile-RC SMTP test succeeded on {platform.node() or 'Linux PC'}.\n"
        f"Online / non-local OTP delivery is ready for {', '.join(allowed)}.\n"
    )
    print(f"Sending test email to {CYAN}{target}{NC} via {host}:{port}...")
    try:
        ctx = ssl.create_default_context()
        if port == 465:
            with smtplib.SMTP_SSL(host, port, timeout=15, context=ctx) as srv:
                srv.login(user, pwd)
                srv.send_message(msg)
        else:
            with smtplib.SMTP(host, port, timeout=15) as srv:
                srv.ehlo()
                srv.starttls(context=ctx)
                srv.ehlo()
                srv.login(user, pwd)
                srv.send_message(msg)
        print(f"{GREEN}✓ Test email sent successfully! Check {target}'s inbox.{NC}")
    except Exception as e:
        print(f"{RED}✗ Failed to send test email: {e}{NC}", file=sys.stderr)
        sys.exit(1)


def setup_email(cfg):
    if os.geteuid() != 0 and not os.access(CONFIG_FILE, os.W_OK):
        print(f"{RED}Permission denied writing {CONFIG_FILE}. Run with: sudo control-access --setup-email{NC}", file=sys.stderr)
        sys.exit(1)

    cur = cfg.get("email_otp") if isinstance(cfg.get("email_otp"), dict) else {}
    def_host = str(cur.get("smtp_host") or "smtp.gmail.com")
    def_port = str(cur.get("smtp_port") or "587")
    def_user = str(cur.get("smtp_user") or "")
    def_allowed = ", ".join(cur.get("allowed_emails") or [])

    print(f"\n{CYAN}===================================================={NC}")
    print(f"{GREEN}{BOLD}   📧 Mobile-RC • Online Email OTP Setup           {NC}")
    print(f"{CYAN}===================================================={NC}")
    print("Tip: For Gmail, turn on 2-Step Verification and create a")
    print("     16-char Google App Password (do NOT use main password).\n")

    host = input(f"SMTP Host [{def_host}]: ").strip() or def_host
    raw_port = input(f"SMTP Port (587=STARTTLS, 465=SSL) [{def_port}]: ").strip() or def_port
    try:
        port = max(1, min(65535, int(raw_port)))
    except ValueError:
        print(f"{RED}Invalid SMTP port.{NC}", file=sys.stderr)
        sys.exit(1)

    while True:
        raw_user = input(f"Bot Sender Email [{def_user}]: ").strip() or def_user
        smtp_user = _norm_email(raw_user)
        if smtp_user:
            break
        print(f"{RED}Please enter a valid sender email address.{NC}")

    prompt_pw = "Bot App Password (hidden; leave empty to keep existing): " if cur.get("smtp_pass") else "Bot App Password (hidden): "
    raw_pass = getpass.getpass(prompt_pw).strip()
    smtp_pass = raw_pass if raw_pass else str(cur.get("smtp_pass") or "").strip()
    if host.lower().endswith("gmail.com"):
        smtp_pass = smtp_pass.replace(" ", "")
    if not smtp_pass:
        print(f"{RED}App Password cannot be empty.{NC}", file=sys.stderr)
        sys.exit(1)

    default_rec = def_allowed or smtp_user
    while True:
        raw_allowed = input(f"Allowed Login Email(s), comma-separated [{default_rec}]: ").strip() or default_rec
        allowed = []
        bad = []
        for item in raw_allowed.split(","):
            norm = _norm_email(item)
            if norm:
                if norm not in allowed:
                    allowed.append(norm)
            elif item.strip():
                bad.append(item.strip())
        if bad:
            print(f"{RED}Invalid email(s): {', '.join(bad)}{NC}")
            continue
        if allowed:
            break
        print(f"{RED}At least one allowed email is required.{NC}")

    cfg["email_otp"] = {
        "enabled": True,
        "smtp_host": host,
        "smtp_port": port,
        "smtp_user": smtp_user,
        "smtp_pass": smtp_pass,
        "allowed_emails": allowed,
    }
    save_config(cfg)
    print(f"\n{GREEN}✓ Email OTP settings saved securely to {CONFIG_FILE} (0600).{NC}")
    print(f"  Sender Bot    : {CYAN}{smtp_user}{NC}")
    print(f"  Allowed Users : {CYAN}{', '.join(allowed)}{NC}")

    ans = input("\nSend a test email right now? [Y/n]: ").strip().lower()
    if ans in ("", "y", "yes"):
        send_test_email(cfg)


def _runit_paths():
    sv_base = next((d for d in ("/etc/sv", "/etc/runit/sv") if os.path.isdir(os.path.join(d, "mobile-rc"))), None)
    service_base = next((d for d in ("/var/service", "/run/runit/service", "/etc/service") if os.path.isdir(d)), None)
    if sv_base and service_base:
        return os.path.join(sv_base, "mobile-rc"), os.path.join(service_base, "mobile-rc")
    return None, None


def _detect_init_mode():
    if _find_bin("systemctl") and os.path.isdir("/run/systemd/system") and (
        os.path.exists("/etc/systemd/system/mobile-rc.service")
        or os.path.exists("/etc/static/systemd/system/mobile-rc.service")
    ):
        return "systemd"
    if _find_bin("rc-service") and os.path.exists("/etc/init.d/mobile-rc"):
        return "openrc"
    if _find_bin("dinitctl") and os.path.exists("/etc/dinit.d/mobile-rc"):
        return "dinit"
    if _find_bin("sv") and _runit_paths()[0] is not None:
        return "runit"
    return "nohup"


def _service_state(mode):
    running = False
    autostart = "unsupported"
    if mode == "systemd":
        running = subprocess.run(["systemctl", "is-active", "--quiet", "mobile-rc.service"], check=False).returncode == 0
        en_rc = subprocess.run(["systemctl", "is-enabled", "--quiet", "mobile-rc.service"], check=False).returncode
        autostart = "enabled" if en_rc == 0 else "disabled"
    elif mode == "openrc":
        running = subprocess.run(["rc-service", "mobile-rc", "status"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False).returncode == 0
        en = os.path.exists("/etc/runlevels/default/mobile-rc")
        if not en and _find_bin("rc-update"):
            res = subprocess.run(["rc-update", "show", "default"], capture_output=True, text=True, check=False)
            if res.returncode == 0 and "mobile-rc" in res.stdout:
                en = True
        autostart = "enabled" if en else "disabled"
    elif mode == "dinit":
        res = subprocess.run(["dinitctl", "status", "mobile-rc"], capture_output=True, text=True, check=False)
        out_u = (res.stdout or "").upper()
        running = res.returncode == 0 and ("STARTED" in out_u or "RUNNING" in out_u)
        autostart = "enabled" if os.path.exists("/etc/dinit.d/boot.d/mobile-rc") else "disabled"
    elif mode == "runit":
        _, svc_link = _runit_paths()
        sv_dir, _ = _runit_paths()
        if svc_link and os.path.lexists(svc_link):
            res = subprocess.run(["sv", "status", svc_link], capture_output=True, text=True, check=False)
            running = res.returncode == 0 and "run:" in (res.stdout or "").lower()
            autostart = "disabled" if os.path.exists(os.path.join(sv_dir, "down")) else "enabled"
        else:
            autostart = "disabled"
    else:
        if _find_bin("pgrep"):
            running = subprocess.run(["pgrep", "-f", "/opt/mobile-rc/server.py"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False).returncode == 0
    return running, autostart


def print_service_status():
    mode = _detect_init_mode()
    running, autostart = _service_state(mode)
    run_lbl = f"{GREEN}running{NC}" if running else f"{YELLOW}stopped{NC}"
    auto_lbl = (
        f"{GREEN}enabled{NC}" if autostart == "enabled"
        else f"{YELLOW}disabled{NC}" if autostart == "disabled"
        else f"{YELLOW}manual (nohup){NC}"
    )
    print(f"Service Status : {run_lbl} (init: {mode})")
    print(f"Boot Auto-Start: {auto_lbl}")


def _require_root_for_service(flag_name):
    if os.geteuid() != 0:
        print(f"{RED}Root permission required. Run with: sudo control-access {flag_name}{NC}", file=sys.stderr)
        sys.exit(1)


def manage_boot_autostart(enable):
    _require_root_for_service("--enable" if enable else "--disable")
    mode = _detect_init_mode()
    if mode == "systemd":
        if os.path.exists("/etc/NIXOS"):
            print(
                f"{YELLOW}NixOS systemd unit is declarative. Set services.mobile-rc.enable in your NixOS config and run sudo nixos-rebuild switch.{NC}",
                file=sys.stderr,
            )
            sys.exit(1)
        action = "enable" if enable else "disable"
        res = subprocess.run(["systemctl", action, "mobile-rc.service"], capture_output=True, text=True, check=False)
    elif mode == "openrc":
        args = ["rc-update", "add", "mobile-rc", "default"] if enable else ["rc-update", "del", "mobile-rc", "default"]
        res = subprocess.run(args, capture_output=True, text=True, check=False)
    elif mode == "dinit":
        args = ["dinitctl", "enable" if enable else "disable", "mobile-rc"]
        res = subprocess.run(args, capture_output=True, text=True, check=False)
    elif mode == "runit":
        sv_dir, svc_link = _runit_paths()
        if not sv_dir or not svc_link:
            print(f"{RED}runit service directory not found.{NC}", file=sys.stderr)
            sys.exit(1)
        down_file = os.path.join(sv_dir, "down")
        if enable:
            if os.path.exists(down_file):
                os.remove(down_file)
            if not os.path.lexists(svc_link):
                os.symlink(sv_dir, svc_link)
        else:
            if not os.path.lexists(svc_link):
                os.symlink(sv_dir, svc_link)
            fd = os.open(down_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
            os.close(fd)
        res = subprocess.CompletedProcess(args=[], returncode=0, stdout="", stderr="")
    else:
        print(f"{YELLOW}No supported init service found; nohup mode does not register boot auto-start.{NC}")
        return
    if res.returncode != 0:
        err = (res.stderr or res.stdout or "").strip()
        print(f"{RED}Failed to update boot auto-start ({mode}): {err}{NC}", file=sys.stderr)
        sys.exit(1)
    state_word = f"{GREEN}enabled{NC}" if enable else f"{YELLOW}disabled{NC}"
    print(f"Mobile-RC boot auto-start is now {state_word} ({mode}).")


def manage_runtime_service(action):
    _require_root_for_service(f"--{action}")
    mode = _detect_init_mode()
    if mode == "systemd":
        res = subprocess.run(["systemctl", action, "mobile-rc.service"], capture_output=True, text=True, check=False)
        if res.returncode != 0:
            print(f"{RED}systemctl {action} failed: {(res.stderr or res.stdout).strip()}{NC}", file=sys.stderr)
            sys.exit(1)
    elif mode == "openrc":
        if action == "stop" and not _service_state(mode)[0]:
            print(f"{YELLOW}Mobile-RC service is already stopped.{NC}")
            return
        res = subprocess.run(["rc-service", "mobile-rc", action], capture_output=True, text=True, check=False)
        if res.returncode != 0:
            print(f"{RED}rc-service {action} failed: {(res.stderr or res.stdout).strip()}{NC}", file=sys.stderr)
            sys.exit(1)
    elif mode == "dinit":
        if action == "stop" and not _service_state(mode)[0]:
            print(f"{YELLOW}Mobile-RC service is already stopped.{NC}")
            return
        res = subprocess.run(["dinitctl", action, "mobile-rc"], capture_output=True, text=True, check=False)
        if res.returncode != 0:
            print(f"{RED}dinitctl {action} failed: {(res.stderr or res.stdout).strip()}{NC}", file=sys.stderr)
            sys.exit(1)
    elif mode == "runit":
        sv_dir, svc_link = _runit_paths()
        if action == "stop" and not _service_state(mode)[0]:
            print(f"{YELLOW}Mobile-RC service is already stopped.{NC}")
            return
        if not os.path.lexists(svc_link):
            os.symlink(sv_dir, svc_link)
        res = subprocess.run(["sv", action, svc_link], capture_output=True, text=True, check=False)
        if res.returncode != 0:
            print(f"{RED}sv {action} failed: {(res.stderr or res.stdout).strip()}{NC}", file=sys.stderr)
            sys.exit(1)
    else:
        if action in ("stop", "restart") and _find_bin("pkill"):
            subprocess.run(["pkill", "-f", "/opt/mobile-rc/server.py"], check=False)
        if action in ("start", "restart"):
            env = os.environ.copy()
            if os.path.exists(CONFIG_FILE):
                try:
                    with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                        t_user = str(json.load(f).get("target_user") or "").strip()
                    if t_user:
                        env["MRC_USER"] = t_user
                except Exception:
                    pass
            with open("/var/log/mobile-rc.log", "ab") as logf:
                subprocess.Popen(
                    [sys.executable, "/opt/mobile-rc/server.py"],
                    env=env,
                    stdin=subprocess.DEVNULL,
                    stdout=logf,
                    stderr=subprocess.STDOUT,
                    start_new_session=True,
                )
    print(f"{GREEN}Mobile-RC service {action} completed ({mode}).{NC}")


def main():
    parser = argparse.ArgumentParser(description="Mobile-RC pairing, Email OTP & service control CLI")
    parser.add_argument("--setup-termux", action="store_true", help="Show 1-line setup command for Termux")
    parser.add_argument("--pair-info", action="store_true", help="Show LAN URLs, NIC MACs (WoL) and app pairing URI")
    parser.add_argument("--setup-email", action="store_true", help="Configure Gmail/SMTP bot & allowed emails for online OTP")
    parser.add_argument("--test-email", action="store_true", help="Send a test email using saved Email OTP settings")
    parser.add_argument("--status", action="store_true", help="Show Mobile-RC service runtime and boot auto-start status")
    boot_grp = parser.add_mutually_exclusive_group()
    boot_grp.add_argument("--enable", action="store_true", help="Enable Mobile-RC auto-start on boot")
    boot_grp.add_argument("--disable", action="store_true", help="Disable Mobile-RC auto-start on boot")
    svc_grp = parser.add_mutually_exclusive_group()
    svc_grp.add_argument("--start", action="store_true", help="Start Mobile-RC background service now")
    svc_grp.add_argument("--stop", action="store_true", help="Stop Mobile-RC background service now")
    svc_grp.add_argument("--restart", action="store_true", help="Restart Mobile-RC background service now")
    parser.add_argument("--port", type=int, default=DEFAULT_PORT, help="Local Mobile-RC server port")
    args = parser.parse_args()

    has_svc_action = any((args.status, args.enable, args.disable, args.start, args.stop, args.restart))
    if has_svc_action:
        if args.enable:
            manage_boot_autostart(True)
        elif args.disable:
            manage_boot_autostart(False)
        if args.start:
            manage_runtime_service("start")
        elif args.stop:
            manage_runtime_service("stop")
        elif args.restart:
            manage_runtime_service("restart")
        if args.status or not (args.start or args.stop or args.restart):
            print_service_status()
        return

    cfg = load_config()
    if args.setup_termux:
        print_termux_setup(cfg, args.port)
    elif args.pair_info:
        print_pair_info(cfg, args.port)
    elif args.setup_email:
        setup_email(cfg)
    elif args.test_email:
        send_test_email(cfg)
    else:
        request_code(cfg, args.port)


if __name__ == "__main__":
    main()
