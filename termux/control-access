#!/usr/bin/env bash
set -euo pipefail

# ==========================================================
# Mobile-RC — Termux Client CLI (`control-access`)
# Requests a fresh random one-time 6-digit access code from
# your paired Linux PC so no static PIN stays active while idle.
# ==========================================================

CFG_DIR="${HOME}/.config/mobile-rc"
CFG_FILE="${CFG_DIR}/config"

BOLD='\033[1m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

usage() {
    cat << 'EOF'
Usage:
  control-access                 Generate a fresh 6-digit one-time code
  control-access -o | --open     Generate code and open dashboard URL
  control-access <URL>           Generate code using a specific URL (saved on success)
  control-access init <TOKEN> <URL1> [URL2...]
                                 Pair this Termux client with your PC
  control-access add-url <URL>   Add another laptop URL (LAN IP or tunnel URL)
  control-access status          Show configured URLs
EOF
}

normalize_url() {
    local u="$1"
    u="${u%/}"
    case "$u" in
        http://*|https://*) printf '%s\n' "$u" ;;
        *) printf 'http://%s:8000\n' "$u" ;;
    esac
}

save_config() {
    local token="$1"
    shift
    mkdir -p -m 700 "${CFG_DIR}"
    local urls_joined="$*"
    local tmp
    tmp="$(mktemp)"
    umask 077
    {
        printf 'MRC_TERMUX_TOKEN=%q\n' "${token}"
        printf 'MRC_URLS=%q\n' "${urls_joined}"
    } > "${tmp}"
    mv -f "${tmp}" "${CFG_FILE}"
    chmod 600 "${CFG_FILE}"
}

load_config() {
    if [ ! -f "${CFG_FILE}" ]; then
        echo -e "${RED}Termux is not paired with your laptop yet.${NC}" >&2
        echo -e "Run ${CYAN}sudo control-access --setup-termux${NC} on your PC and paste the command here." >&2
        exit 1
    fi
    # shellcheck disable=SC1090
    source "${CFG_FILE}"
    if [ -z "${MRC_TERMUX_TOKEN:-}" ] || [ -z "${MRC_URLS:-}" ]; then
        echo -e "${RED}Invalid config in ${CFG_FILE}. Re-run 'control-access init ...'.${NC}" >&2
        exit 1
    fi
}

json_extract_str() {
    local key="$1"
    local json="$2"
    printf '%s' "${json}" \
        | grep -oE "\"${key}\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" \
        | head -n 1 \
        | sed -E 's/^[^:]+:[[:space:]]*"([^"]*)"$/\1/'
}

json_extract_int() {
    local key="$1"
    local json="$2"
    printf '%s' "${json}" \
        | grep -oE "\"${key}\"[[:space:]]*:[[:space:]]*[0-9]+" \
        | head -n 1 \
        | sed -E 's/^[^:]+:[[:space:]]*([0-9]+)$/\1/'
}

cmd_init() {
    if [ "$#" -lt 2 ]; then
        echo -e "${RED}Usage: control-access init <TOKEN> <URL1> [URL2...]${NC}" >&2
        exit 1
    fi
    local token="$1"
    shift
    local urls=()
    local u
    for u in "$@"; do
        urls+=("$(normalize_url "$u")")
    done
    save_config "${token}" "${urls[@]}"
    echo -e "${GREEN}✓ Mobile-RC Termux pairing saved to ${CFG_FILE} (mode 600).${NC}"
    echo -e "Type ${CYAN}control-access${NC} anytime to generate a random access code."
}

cmd_add_url() {
    if [ "$#" -lt 1 ]; then
        echo -e "${RED}Usage: control-access add-url <URL>${NC}" >&2
        exit 1
    fi
    load_config
    local new_u
    new_u="$(normalize_url "$1")"
    local updated=("${new_u}")
    local existing
    for existing in ${MRC_URLS}; do
        if [ "${existing}" != "${new_u}" ]; then
            updated+=("${existing}")
        fi
    done
    save_config "${MRC_TERMUX_TOKEN}" "${updated[@]}"
    echo -e "${GREEN}✓ Added primary URL: ${new_u}${NC}"
}

cmd_status() {
    load_config
    echo -e "${CYAN}Configured Mobile-RC URLs:${NC}"
    local u
    for u in ${MRC_URLS}; do
        echo "  - ${u}"
    done
}

request_code_from_url() {
    local url="$1"
    local token="$2"
    if command -v curl >/dev/null 2>&1; then
        curl -sS --max-time 3 -w '\nHTTP_STATUS:%{http_code}' \
            -X POST \
            -H "Authorization: Bearer ${token}" \
            -H "Content-Type: application/json" \
            -d '{}' \
            "${url}/api/pairing/code" 2>/dev/null || return 1
    elif command -v python3 >/dev/null 2>&1; then
        python3 - "${url}/api/pairing/code" "${token}" << 'PYEOF'
import sys, urllib.request, urllib.error
req = urllib.request.Request(
    sys.argv[1],
    data=b"{}",
    headers={"Authorization": "Bearer " + sys.argv[2], "Content-Type": "application/json"},
    method="POST",
)
try:
    with urllib.request.urlopen(req, timeout=3) as r:
        print(r.read().decode("utf-8"))
        print(f"HTTP_STATUS:{r.status}")
except urllib.error.HTTPError as e:
    print(e.read().decode("utf-8", errors="ignore"))
    print(f"HTTP_STATUS:{e.code}")
except Exception:
    sys.exit(1)
PYEOF
    else
        echo -e "${RED}Error: Please install curl in Termux: pkg install curl${NC}" >&2
        exit 1
    fi
}

cmd_request() {
    local open_browser=0
    local custom_url=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -o|--open) open_browser=1 ;;
            -h|--help) usage; exit 0 ;;
            *) custom_url="$(normalize_url "$1")" ;;
        esac
        shift
    done

    load_config

    local candidates=()
    if [ -n "${custom_url}" ]; then
        candidates+=("${custom_url}")
    fi
    local u
    for u in ${MRC_URLS}; do
        if [ "${u}" != "${custom_url}" ]; then
            candidates+=("${u}")
        fi
    done

    local chosen_url="" body="" http_code=""
    for u in "${candidates[@]}"; do
        local raw
        if raw="$(request_code_from_url "${u}" "${MRC_TERMUX_TOKEN}")"; then
            http_code="$(printf '%s\n' "${raw}" | sed -n 's/^HTTP_STATUS://p' | tail -n 1)"
            body="$(printf '%s\n' "${raw}" | sed '/^HTTP_STATUS:/d')"
            if [ "${http_code}" = "200" ]; then
                chosen_url="${u}"
                break
            elif [ "${http_code}" = "401" ] || [ "${http_code}" = "403" ] || [ "${http_code}" = "429" ]; then
                local msg
                msg="$(json_extract_str "message" "${body}")"
                echo -e "${RED}Rejected by ${u} (HTTP ${http_code}): ${msg:-Authentication error}${NC}" >&2
                exit 1
            fi
        fi
    done

    if [ -z "${chosen_url}" ]; then
        echo -e "${RED}Could not reach your laptop Mobile-RC server.${NC}" >&2
        echo -e "Checked URLs: ${MRC_URLS}" >&2
        echo -e "Tip: Check Wi-Fi/Hotspot connection, or pass current laptop IP: ${CYAN}control-access http://<LAPTOP_IP>:8000${NC}" >&2
        exit 1
    fi

    # Save custom URL as first priority if it succeeded
    if [ -n "${custom_url}" ] && [ "${chosen_url}" = "${custom_url}" ]; then
        local updated=("${custom_url}")
        for u in ${MRC_URLS}; do
            [ "${u}" != "${custom_url}" ] && updated+=("${u}")
        done
        save_config "${MRC_TERMUX_TOKEN}" "${updated[@]}"
    fi

    local code ttl tunnel_url
    code="$(json_extract_str "code" "${body}")"
    ttl="$(json_extract_int "expires_in" "${body}")"
    tunnel_url="$(json_extract_str "tunnel_url" "${body}")"

    if [ -z "${code}" ]; then
        echo -e "${RED}Unexpected response from server: ${body}${NC}" >&2
        exit 1
    fi

    echo ""
    echo -e "${CYAN}============================================${NC}"
    echo -e "${GREEN}${BOLD}   🔑 Mobile-RC • Random Access Code        ${NC}"
    echo -e "${CYAN}============================================${NC}"
    echo -e "   Code    : ${YELLOW}${BOLD}${code}${NC}"
    echo -e "   Valid   : ${ttl:-180}s (single-use)"
    echo -e "   URL     : ${CYAN}${chosen_url}${NC}"
    if [ -n "${tunnel_url}" ]; then
        echo -e "   Tunnel  : ${CYAN}${tunnel_url}${NC}"
    fi
    echo -e "${CYAN}============================================${NC}"

    if command -v termux-clipboard-set >/dev/null 2>&1; then
        printf '%s' "${code}" | termux-clipboard-set 2>/dev/null || true
        echo -e "${GREEN}✓ Code copied to Android clipboard.${NC}"
    fi

    if [ "${open_browser}" -eq 1 ]; then
        if command -v termux-open-url >/dev/null 2>&1; then
            termux-open-url "${chosen_url}/?v=2" 2>/dev/null || true
        elif command -v am >/dev/null 2>&1; then
            am start -a android.intent.action.VIEW -d "${chosen_url}/?v=2" >/dev/null 2>&1 || true
        fi
    fi
    echo ""
}

case "${1:-}" in
    init) shift; cmd_init "$@" ;;
    add-url) shift; cmd_add_url "$@" ;;
    status) cmd_status ;;
    -h|--help) usage ;;
    *) cmd_request "$@" ;;
esac
