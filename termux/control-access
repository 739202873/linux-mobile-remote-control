#!/usr/bin/env bash
set -euo pipefail

# ==========================================================
# Mobile-RC — Termux Client CLI (`control-access`)
# Token-free client:
# - Local LAN: prompts for 6-digit RAC from `sudo control-access` on PC/Laptop
# - Non-Local: requests 6-digit RAC via Email OTP, then prompts for the RAC
# Verified RAC automatically opens and logs into the web dashboard.
# ==========================================================

CFG_DIR="${HOME}/.config/mobile-rc"
CFG_FILE="${CFG_DIR}/config"

BOLD='\033[1m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

usage() {
    cat << 'EOF'
Usage:
  control-access                 Connect (Local RAC from PC, or Email RAC if non-local)
  control-access <6-DIGIT-RAC>   Verify 6-digit RAC and auto-open unlocked dashboard
  control-access <URL>           Connect using a specific host/tunnel URL
  control-access init <URL1> [URL2...]
                                 Save PC / host URL(s) (no static token stored on phone)
  control-access add-url <URL>   Add another PC / host URL (LAN IP or tunnel URL)
  control-access status          Show configured URLs and saved email
EOF
}

is_url_or_host() {
    local s="$1"
    case "$s" in
        http://*|https://*) return 0 ;;
        *.*.*.*|localhost|localhost:*|*.*.*.*:*|*.local|*.local:*|*.lhr.life*|*.trycloudflare.com*|*.ngrok*) return 0 ;;
        *) return 1 ;;
    esac
}

normalize_url() {
    local u="$1"
    u="${u%/}"
    case "$u" in
        http://*|https://*) printf '%s\n' "$u" ;;
        *) printf 'http://%s:8000\n' "$u" ;;
    esac
}

save_config() {
    local email="$1"
    shift
    mkdir -p -m 700 "${CFG_DIR}"
    local urls_joined="$*"
    local tmp="${CFG_DIR}/.config.tmp.$$"
    umask 077
    {
        printf 'MRC_EMAIL=%q\n' "${email}"
        printf 'MRC_URLS=%q\n' "${urls_joined}"
    } > "${tmp}"
    mv -f "${tmp}" "${CFG_FILE}"
    chmod 600 "${CFG_FILE}"
}

load_config() {
    if [ ! -f "${CFG_FILE}" ]; then
        echo -e "${RED}Termux is not configured with your PC / host URL yet.${NC}" >&2
        echo -e "Run ${CYAN}sudo control-access --setup-termux${NC} on your PC and paste the command here." >&2
        exit 1
    fi
    # shellcheck disable=SC1090
    source "${CFG_FILE}"
    MRC_EMAIL="${MRC_EMAIL:-}"
    if [ -z "${MRC_URLS:-}" ]; then
        echo -e "${RED}Invalid config in ${CFG_FILE}. Re-run 'control-access init <URL>'.${NC}" >&2
        exit 1
    fi
}

json_extract_str() {
    local key="$1"
    local json="$2"
    printf '%s' "${json}" \
        | grep -oE "\"${key}\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" \
        | head -n 1 \
        | sed -E 's/^[^:]+:[[:space:]]*"([^"]*)"$/\1/'
}

json_extract_bool() {
    local key="$1"
    local json="$2"
    printf '%s' "${json}" \
        | grep -oE "\"${key}\"[[:space:]]*:[[:space:]]*(true|false)" \
        | head -n 1 \
        | sed -E 's/^[^:]+:[[:space:]]*(true|false)$/\1/'
}

http_get() {
    local url="$1"
    if command -v curl >/dev/null 2>&1; then
        curl -sS --max-time 4 -w '\nHTTP_STATUS:%{http_code}' "${url}" 2>/dev/null || return 1
    elif command -v python3 >/dev/null 2>&1; then
        python3 - "${url}" << 'PYEOF'
import sys, urllib.request, urllib.error
try:
    with urllib.request.urlopen(sys.argv[1], timeout=4) as r:
        print(r.read().decode("utf-8"))
        print(f"HTTP_STATUS:{r.status}")
except urllib.error.HTTPError as e:
    print(e.read().decode("utf-8", errors="ignore"))
    print(f"HTTP_STATUS:{e.code}")
except Exception:
    sys.exit(1)
PYEOF
    else
        echo -e "${RED}Error: Please install curl in Termux: pkg install curl${NC}" >&2
        exit 1
    fi
}

http_post_json() {
    local url="$1"
    local payload="$2"
    if command -v curl >/dev/null 2>&1; then
        curl -sS --max-time 10 -w '\nHTTP_STATUS:%{http_code}' \
            -X POST \
            -H "Content-Type: application/json" \
            -d "${payload}" \
            "${url}" 2>/dev/null || return 1
    elif command -v python3 >/dev/null 2>&1; then
        python3 - "${url}" "${payload}" << 'PYEOF'
import sys, urllib.request, urllib.error
req = urllib.request.Request(
    sys.argv[1],
    data=sys.argv[2].encode("utf-8"),
    headers={"Content-Type": "application/json"},
    method="POST",
)
try:
    with urllib.request.urlopen(req, timeout=10) as r:
        print(r.read().decode("utf-8"))
        print(f"HTTP_STATUS:{r.status}")
except urllib.error.HTTPError as e:
    print(e.read().decode("utf-8", errors="ignore"))
    print(f"HTTP_STATUS:{e.code}")
except Exception:
    sys.exit(1)
PYEOF
    else
        echo -e "${RED}Error: Please install curl in Termux: pkg install curl${NC}" >&2
        exit 1
    fi
}

open_url_in_browser() {
    local target_url="$1"
    if command -v termux-open-url >/dev/null 2>&1; then
        termux-open-url "${target_url}" 2>/dev/null && return 0
    fi
    if command -v am >/dev/null 2>&1; then
        am start -a android.intent.action.VIEW -d "${target_url}" >/dev/null 2>&1 && return 0
    fi
    return 1
}

cmd_init() {
    if [ "$#" -lt 1 ]; then
        echo -e "${RED}Usage: control-access init <URL1> [URL2...]${NC}" >&2
        exit 1
    fi
    local urls=()
    local arg
    for arg in "$@"; do
        if is_url_or_host "${arg}"; then
            urls+=("$(normalize_url "${arg}")")
        fi
    done
    if [ "${#urls[@]}" -eq 0 ]; then
        echo -e "${RED}No valid host URL provided to 'control-access init'.${NC}" >&2
        exit 1
    fi
    local prev_email=""
    if [ -f "${CFG_FILE}" ]; then
        # shellcheck disable=SC1090
        source "${CFG_FILE}" || true
        prev_email="${MRC_EMAIL:-}"
    fi
    save_config "${prev_email}" "${urls[@]}"
    echo -e "${GREEN}Mobile-RC host URL(s) saved to ${CFG_FILE} (token-free mode).${NC}"
    echo -e "Type ${CYAN}control-access${NC} anytime to enter your 6-digit RAC and auto-open the dashboard."
}

cmd_add_url() {
    if [ "$#" -lt 1 ]; then
        echo -e "${RED}Usage: control-access add-url <URL>${NC}" >&2
        exit 1
    fi
    load_config
    local new_u
    new_u="$(normalize_url "$1")"
    local updated=("${new_u}")
    local existing
    for existing in ${MRC_URLS}; do
        if [ "${existing}" != "${new_u}" ]; then
            updated+=("${existing}")
        fi
    done
    save_config "${MRC_EMAIL:-}" "${updated[@]}"
    echo -e "${GREEN}Added primary URL: ${new_u}${NC}"
}

cmd_status() {
    load_config
    echo -e "${CYAN}Configured Mobile-RC URLs (token-free RAC mode):${NC}"
    local u
    for u in ${MRC_URLS}; do
        echo "  - ${u}"
    done
    if [ -n "${MRC_EMAIL:-}" ]; then
        echo -e "${CYAN}Saved Email:${NC} ${MRC_EMAIL}"
    fi
}

cmd_connect() {
    local custom_url=""
    local supplied_rac=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -o|--open) ;;
            -h|--help) usage; exit 0 ;;
            [0-9][0-9][0-9][0-9][0-9][0-9]) supplied_rac="$1" ;;
            *) custom_url="$(normalize_url "$1")" ;;
        esac
        shift
    done

    load_config

    local candidates=()
    if [ -n "${custom_url}" ]; then
        candidates+=("${custom_url}")
    fi
    local u
    for u in ${MRC_URLS}; do
        if [ "${u}" != "${custom_url}" ]; then
            candidates+=("${u}")
        fi
    done

    local chosen_url="" status_body="" http_code=""
    for u in "${candidates[@]}"; do
        local raw
        if raw="$(http_get "${u}/api/auth/status")"; then
            http_code="$(printf '%s\n' "${raw}" | sed -n 's/^HTTP_STATUS://p' | tail -n 1)"
            status_body="$(printf '%s\n' "${raw}" | sed '/^HTTP_STATUS:/d')"
            if [ "${http_code}" = "200" ]; then
                chosen_url="${u}"
                break
            fi
        fi
    done

    if [ -z "${chosen_url}" ]; then
        echo -e "${RED}Could not reach your PC / host Mobile-RC server.${NC}" >&2
        echo -e "Checked URLs: ${MRC_URLS}" >&2
        echo -e "Tip: If on a different network, pass your tunnel URL: ${CYAN}control-access https://<tunnel-url>${NC}" >&2
        exit 1
    fi

    if [ -n "${custom_url}" ] && [ "${chosen_url}" = "${custom_url}" ]; then
        local updated=("${custom_url}")
        for u in ${MRC_URLS}; do
            [ "${u}" != "${custom_url}" ] && updated+=("${u}")
        done
        save_config "${MRC_EMAIL:-}" "${updated[@]}"
    fi

    local is_non_local email_enabled
    is_non_local="$(json_extract_bool "is_non_local" "${status_body}")"
    email_enabled="$(json_extract_bool "email_otp_enabled" "${status_body}")"

    echo ""
    echo -e "${CYAN}====================================================${NC}"
    if [ "${is_non_local}" = "true" ]; then
        echo -e "${GREEN}${BOLD}   Mobile-RC • Non-Local Access (Email RAC)${NC}"
        echo -e "${CYAN}====================================================${NC}"
        echo -e "   Server : ${CYAN}${chosen_url}${NC}"
        if [ "${email_enabled}" != "true" ]; then
            echo -e "${RED}Email OTP belum dikonfigurasi di PC/Laptop.${NC}" >&2
            echo -e "Jalankan ${CYAN}sudo control-access --setup-email${NC} di PC/Laptop terlebih dahulu." >&2
            exit 1
        fi
        if [ -z "${supplied_rac}" ]; then
            local prompt_email="${MRC_EMAIL:-}"
            local input_email=""
            if [ -n "${prompt_email}" ]; then
                read -r -p "Masukkan Email terdaftar [${prompt_email}]: " input_email
                input_email="${input_email:-${prompt_email}}"
            else
                read -r -p "Masukkan Email terdaftar: " input_email
            fi
            input_email="$(printf '%s' "${input_email}" | tr -d '[:space:]')"
            if [ -z "${input_email}" ]; then
                echo -e "${RED}Alamat email tidak boleh kosong.${NC}" >&2
                exit 1
            fi
            save_config "${input_email}" ${MRC_URLS}
            echo -e "Mengirim 6-digit RAC ke ${CYAN}${input_email}${NC}..."
            local email_payload email_raw email_http email_body email_msg
            email_payload="$(printf '{"email":"%s"}' "${input_email//\"/}")"
            if ! email_raw="$(http_post_json "${chosen_url}/api/pairing/email-code" "${email_payload}")"; then
                echo -e "${RED}Gagal menghubungi server untuk mengirim Email RAC.${NC}" >&2
                exit 1
            fi
            email_http="$(printf '%s\n' "${email_raw}" | sed -n 's/^HTTP_STATUS://p' | tail -n 1)"
            email_body="$(printf '%s\n' "${email_raw}" | sed '/^HTTP_STATUS:/d')"
            email_msg="$(json_extract_str "message" "${email_body}")"
            if [ "${email_http}" != "200" ]; then
                echo -e "${RED}Gagal mengirim Email RAC (HTTP ${email_http}): ${email_msg}${NC}" >&2
                exit 1
            fi
            echo -e "${GREEN}${email_msg:-Kode 6-digit RAC telah dikirim ke email Anda.}${NC}"
            read -r -p "Masukkan 6-digit RAC dari Email: " supplied_rac
        fi
    else
        echo -e "${GREEN}${BOLD}   Mobile-RC • Local LAN Access (Host RAC)${NC}"
        echo -e "${CYAN}====================================================${NC}"
        echo -e "   Server : ${CYAN}${chosen_url}${NC}"
        echo -e "   Info   : Jalankan ${YELLOW}sudo control-access${NC} di PC/Laptop Anda."
        if [ -z "${supplied_rac}" ]; then
            read -r -p "Masukkan 6-digit RAC dari PC/Laptop: " supplied_rac
        fi
    fi

    supplied_rac="$(printf '%s' "${supplied_rac}" | tr -d '[:space:]')"
    if [ -z "${supplied_rac}" ]; then
        echo -e "${RED}Kode RAC tidak boleh kosong.${NC}" >&2
        exit 1
    fi

    local login_payload login_raw login_http login_body handoff_token err_msg
    login_payload="$(printf '{"pin":"%s","handoff":true}' "${supplied_rac//\"/}")"
    if ! login_raw="$(http_post_json "${chosen_url}/api/login" "${login_payload}")"; then
        echo -e "${RED}Gagal memverifikasi RAC ke ${chosen_url}.${NC}" >&2
        exit 1
    fi
    login_http="$(printf '%s\n' "${login_raw}" | sed -n 's/^HTTP_STATUS://p' | tail -n 1)"
    login_body="$(printf '%s\n' "${login_raw}" | sed '/^HTTP_STATUS:/d')"

    if [ "${login_http}" != "200" ]; then
        err_msg="$(json_extract_str "message" "${login_body}")"
        echo -e "${RED}Verifikasi gagal (HTTP ${login_http}): ${err_msg:-Kode RAC salah atau kedaluwarsa}${NC}" >&2
        exit 1
    fi

    handoff_token="$(json_extract_str "handoff_token" "${login_body}")"
    local target_url="${chosen_url}/?handoff=${handoff_token}"
    echo -e "${GREEN}RAC terverifikasi! Membuka dashboard secara otomatis...${NC}"
    if ! open_url_in_browser "${target_url}"; then
        echo -e "Buka URL ini di browser HP Anda:"
        echo -e "  ${CYAN}${target_url}${NC}"
    fi
    echo -e "${CYAN}====================================================${NC}\n"
}

case "${1:-}" in
    init) shift; cmd_init "$@" ;;
    add-url) shift; cmd_add_url "$@" ;;
    status) cmd_status ;;
    -h|--help) usage ;;
    *) cmd_connect "$@" ;;
esac
